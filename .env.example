# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fraud_db
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=change_me_please
# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=transactions
KAFKA_DLQ_TOPIC=transactions.dlq
KAFKA_GROUP_ID=fraud-scorer
# ---- Spark ----
SPARK_CHECKPOINT_DIR=./data/checkpoints
SPARK_SHUFFLE_PARTITIONS=4
# ---- ML / MLflow ----
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db
MLFLOW_EXPERIMENT=fraud-detection
MODEL_DIR=./models
MODEL_NAME=fraud-xgb
# ---- Data ----
DATA_DIR=./data
PAYSIM_CSV=./data/raw/paysim.csv
# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_KEY=
ALERT_RISK_THRESHOLD=80
LOG_LEVEL=INFO
